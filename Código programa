print("\t QUE COMIENCE LA PARTIDA!")


fichas = ["Coche", "Sombrero", "Perro", "Barco"]
fichas_asignadas = []


for i in range(jugadores):
    numero_ficha = random.randint(0, len(fichas) - 1)
    ficha = fichas.pop(numero_ficha)
    fichas_asignadas.append(ficha)


for i in range(jugadores):
    print(f"{nombres[i]} ({fichas_asignadas[i]}) : {saldo[i]}€")




